{
	admin off
}

web-tycoon.ru {
	root * /srv/build
	encode zstd gzip
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}.html {path}/index.html /200.html
	file_server
}

www.web-tycoon.ru {
	redir https://web-tycoon.ru{uri} permanent
}

api.web-tycoon.ru {
	reverse_proxy backend:3210
}

hooks.web-tycoon.ru {
	reverse_proxy backend:3211
}
